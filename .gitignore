# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local env
.env
.env.local

# Scryfall card image cache (regenerate via scripts/fetch_card_images.py)
data/card_images/

# Throwaway UI screenshots (regenerate via scripts/screenshot_ui.py)
ui_screenshots/
src/mtg_bot/static/screenshots/

# Node toolchain for the JS test suite (Vitest); regenerate via `npm install`
node_modules/
package-lock.json

# Local log files (dev server output, perf history, etc.). The
# perf history written by hooks/post-commit is the canonical example;
# the `*.log` glob also covers ad-hoc dev server logs (ui_server.log,
# etc.) so they don't get accidentally committed.
*.log

# NN training artifacts: generated self-play data and trained weights.
# Both regenerable via scripts/generate_training_data.py + train_nn.py.
training_data/
trained_weights/

# Live per-epoch progress JSON written by train_nn.py for the
# training-progress UI to poll. Each file is ephemeral / recreated
# on the next run, so don't commit them.
training_progress/

# Captured per-game replays (gzipped JSON), written by data gen with
# --save-replays-to. Regenerable; can be huge for long training runs.
replays/

# Hang diagnostics — meta.json + traceback.txt dumped per per-game
# timeout event by iterate_alphazero. Useful for debugging the engine
# hang bug (todo 9c5e3b71) but never something we'd commit.
debug_hangs/

# Bench reports written by scripts/bench_ismcts_vs_pimc_strength.py.
# JSON-per-run (timestamped); regenerable; track strength trends across
# NN versions over time but the artifacts themselves are operator-local.
bench_results/

# cProfile dumps written by scripts/profile_ismcts_choose.py and
# scripts/profile_self_play_game.py. Per-run, multi-MB binary, never
# something we'd want in git history. The accompanying analysis docs
# under docs/ ARE committed.
profile_results/

# 17lands public data + parsed deck cache. The raw CSVs are 100s of
# MB; the parsed deck JSON is much smaller but still derived data.
# Regenerable via scripts/fetch_17lands_data.py.
data/17lands/

# Cargo build artifacts for the rust/ engine crate. Rebuilt by
# `maturin develop --release -m rust/pyproject.toml`; the resulting
# .pyd lands in the venv's site-packages, not in the source tree.
rust/target/

# Per-worktree isolated-build scratch produced by
# scripts/setup_rust_worktree_venv.ps1 (Mechanism A in
# docs/RUST_PARALLELIZATION_FEASIBILITY.md). `.venv-wt` is already
# covered by the `.venv-*/` glob above; `_wt_wheels/` is the
# maturin-build wheel output dir — worktree-local scratch, never
# committed.
_wt_wheels/

# Trained deck-belief model artifacts (Step 2 of the NN representation
# roadmap). Built by scripts/train_deck_belief.py from the 17lands EoE
# corpus. The .npz baseline + .pt NN are regenerable; the validation
# JSON report goes to training_progress/ (already gitignored).
models/

