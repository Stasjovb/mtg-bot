# mtg-bot worker daemon — systemd unit
#
# Install: copy to /etc/systemd/system/mtg-bot-worker.service, fill in
# the placeholders below, then:
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable mtg-bot-worker
#   sudo systemctl start mtg-bot-worker
#   sudo systemctl status mtg-bot-worker
#
# Logs land in journalctl: `journalctl -u mtg-bot-worker -f`.
#
# Placeholders to fill in (run `tailscale ip -4` for the IP):
#   ${TAILNET_IP}   — tailnet IP this machine binds on, e.g. 100.96.1.2
#   ${N_WORKERS}    — multiprocessing pool size (cpu_count - 2 is a
#                     reasonable default)
#   ${USER}         — service user (NOT root; the user that owns the
#                     mtg-bot venv)
#   ${HOME}         — home directory of ${USER}
#   ${REPO_ROOT}    — absolute path to the mtg-bot checkout, e.g.
#                     /home/gregg/projects/mtg-bot
#   ${VENV_PYTHON}  — absolute path to the Python interpreter in the
#                     project venv, e.g.
#                     /home/gregg/projects/mtg-bot/.venv-py313/bin/python
#
# AWS EC2 SPOT WORKERS ONLY: append ` --spot-watch` to the end of the
# ExecStart line below (see the commented variant). On the ~2-minute
# spot reclaim warning the daemon stops claiming + drains its
# in-flight game locally — the same graceful path as POST /v2/stop —
# instead of vanishing mid-game and stranding its claims for ~90s of
# heartbeat-DEAD reclaim. Leave it OFF on on-prem / non-AWS workers
# (there is no IMDS endpoint off EC2). See deploy/README.md section
# "AWS EC2 spot workers — --spot-watch".
#
# GPU HOSTS ONLY: append ` --nn-device cuda` to the ExecStart line
# (see the commented GPU variant). This moves NN-eval to the GPU — a
# validated A/B measured ≈2× per-game at production depth on this
# path. Default is `cpu` (byte-identical to the historical CPU-only
# path); enable only on hosts with a working CUDA torch build. Safe
# under spawn/fork: the device string is resolved per-worker inside
# the subprocess, never in the daemon parent. See deploy/README.md
# section "GPU hosts — --nn-device".

[Unit]
Description=MTG-Bot worker daemon (distributed self-play / eval, REST)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=${USER}
WorkingDirectory=${REPO_ROOT}
Environment="PYTHONPATH=${REPO_ROOT}/src"
ExecStart=${VENV_PYTHON} -m mtg_bot.worker_daemon \
  --host ${TAILNET_IP} \
  --port 5198 \
  --n-workers ${N_WORKERS} \
  --deck-pool-path ${REPO_ROOT}/data/17lands/eoe_decks.json.gz \
  --weights-cache-root ${REPO_ROOT}/trained_weights
# EC2 spot variant — use THIS ExecStart instead (comment out the one
# above, uncomment the five lines below) on AWS spot instances:
# ExecStart=${VENV_PYTHON} -m mtg_bot.worker_daemon \
#   --host ${TAILNET_IP} \
#   --port 5198 \
#   --n-workers ${N_WORKERS} \
#   --deck-pool-path ${REPO_ROOT}/data/17lands/eoe_decks.json.gz \
#   --weights-cache-root ${REPO_ROOT}/trained_weights \
#   --spot-watch
# GPU-host variant — use THIS ExecStart instead on a host with a
# working CUDA torch build (combine with --spot-watch if it's also an
# EC2 spot GPU instance):
# ExecStart=${VENV_PYTHON} -m mtg_bot.worker_daemon \
#   --host ${TAILNET_IP} \
#   --port 5198 \
#   --n-workers ${N_WORKERS} \
#   --deck-pool-path ${REPO_ROOT}/data/17lands/eoe_decks.json.gz \
#   --weights-cache-root ${REPO_ROOT}/trained_weights \
#   --nn-device cuda

# Crash-restart policy: every failure, 30s backoff. Matches the
# launchd / Task Scheduler defaults so all three platforms behave
# the same way.
Restart=on-failure
RestartSec=30

# Tighten the process a little. The daemon is a Python HTTP service
# plus a multiprocessing pool; no special privileges needed.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
